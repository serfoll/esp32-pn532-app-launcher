# Copy this file to .env and fill in your own key (get one at
# https://www.steamgriddb.com/profile/preferences/api). .env is gitignored —
# never commit your real key.
#
# Optional: when set, game artwork is looked up on SteamGridDB first and
# falls back to local folder art / the exe's own icon if unset, offline, or
# no match is found.
STEAMGRIDDB_API_KEY=
